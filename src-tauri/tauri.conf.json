{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sepela ERP",
  "version": "0.1.0",
  "identifier": "com.sepela.erp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sepela ERP",
        "width": 1280,
        "height": 800,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "copyright": "Copyright © SEPELA INC. All rights reserved.",
    "license": "Proprietary",
    "licenseFile": "installer/EULA.rtf",
    "category": "Business",
    "shortDescription": "Sepela ERP — point of sale and store management",
    "longDescription": "Desktop POS and inventory for pharmacies and retail. Offline-first with optional SEPELA cloud sync, operator licensing, and device activation.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["English", "French"],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "French": "./windows/languages/French.nsh"
        },
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "startMenuFolder": "SEPELA INC"
      },
      "wix": {
        "language": ["en-US", "fr-FR"]
      }
    }
  }
}
