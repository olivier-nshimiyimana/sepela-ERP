# Local development (npm run dev / tauri dev)
VITE_PORTAL_API_URL=http://127.0.0.1:4000
VITE_PORTAL_API_TOKEN=

# Production (see .env.production — API URL defaults to https://sepela-erp-api.onrender.com)
# Portal admin UI: https://sepela-erp-portal-admin.onrender.com/
# Set VITE_PORTAL_API_TOKEN to the same value as portal-api PORTAL_BEARER_TOKEN before build:installer.
